+      rows.forEach(r => {
+        const sel = r.querySelector(".strategy-select");
+        sel.dataset.current = select.value;
+        sel.value = select.value;
+      });
+      flashStatus(`Applied to ${rows.length} sells in this cycle`, false);
+    } catch (err) {
+      flashStatus("Could not apply to cycle: " + err.message, true);
+    }
+  });
+});
+
+// ── Manage strategies dialog ──
+const dialog     = document.getElementById("strategyDialog");
+const listEl     = document.getElementById("strategyList");
+const msgEl      = document.getElementById("strategyMsg");
+
+function renderStrategyList() {
+  listEl.textContent = "";
+  STRATEGIES.forEach(st => {
+    const li = document.createElement("li");
+    li.className = "flex items-center gap-2";
+
+    const input = document.createElement("input");
+    input.type = "text"; input.maxLength = 60; input.value = st.name;
+    input.className = "flex-1 bg-slate-900 border border-slate-600 text-sm rounded-md px-2 py-1 " +
+                      (st.is_active ? "text-slate-200" : "text-slate-500");
+    const save = async () => {
+      const name = input.value.trim();
+      if (!name || name === st.name) { input.value = st.name; return; }
+      await changeStrategy(st.id, { name });
+    };
+    input.addEventListener("blur", save);
+    input.addEventListener("keydown", e => { if (e.key === "Enter") { e.preventDefault(); input.blur(); } });
+
+    const toggle = document.createElement("button");
+    toggle.type = "button";
+    toggle.className = "text-xs border border-slate-600 hover:border-slate-500 rounded-md px-2 py-1 " +
+                       (st.is_active ? "text-slate-400 hover:text-white" : "text-emerald-400");
+    toggle.textContent = st.is_active ? "Hide" : "Show";
