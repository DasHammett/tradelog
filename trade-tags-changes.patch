+});
+document.getElementById("strategyDialogClose").addEventListener("click", () => dialog.close());
+dialog.addEventListener("click", e => { if (e.target === dialog) dialog.close(); });
+
+document.getElementById("strategyAddForm").addEventListener("submit", async e => {
+  e.preventDefault();
+  const input = document.getElementById("strategyAddInput");
+  const name  = input.value.trim();
