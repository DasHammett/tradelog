+      // Pages that size charts from window "resize" (trade chart) need a nudge once the
+      // width transition has finished; ResizeObserver-based charts (dashboard) adapt by themselves.
+      nav.addEventListener("transitionend", e => {
+        if (e.propertyName === "width") window.dispatchEvent(new Event("resize"));
+      });
+    })();
+  </script>
+
